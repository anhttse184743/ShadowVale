{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShadowVale content bundle schema version 1.0",
  "description": "Backend content bundle contract. Records refer to stable codes within the same content version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_no",
    "label",
    "schema_version",
    "items",
    "weapons",
    "consumables",
    "skills",
    "loot_tables",
    "loot_table_entries",
    "maps",
    "map_loot_tables",
    "enemy_types",
    "enemy_placements",
    "crafting_recipes",
    "crafting_recipe_ingredients",
    "quests",
    "quest_rewards"
  ],
  "properties": {
    "version_no": {
      "type": "integer",
      "minimum": 1
    },
    "label": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "changelog": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_version_id": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    },
    "checksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "item_type",
          "rarity",
          "max_stack",
          "weight",
          "base_value",
          "stats"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "pattern": ".*\\S.*"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "item_type": {
            "type": "string",
            "enum": [
              "weapon",
              "ammo",
              "consumable",
              "material",
              "tool",
              "armor",
              "quest_item"
            ]
          },
          "rarity": {
            "type": "string",
            "enum": [
              "common",
              "uncommon",
              "rare",
              "epic",
              "legendary"
            ]
          },
          "max_stack": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "multipleOf": 1
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 9999.99,
            "multipleOf": 0.01
          },
          "base_value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "multipleOf": 1
          },
          "stats": {
            "type": "object"
          },
          "icon_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_version_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      }
    },
    "weapons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_code",
          "item_type",
          "weapon_class",
          "damage",
          "fire_rate",
          "effective_range",
          "magazine_size",
          "reload_time_s",
          "ammo_type",
          "max_durability",
          "durability_per_use",
          "noise_radius",
          "is_suppressed"
        ],
        "properties": {
          "item_code": {
            "type": "string"
          },
          "item_type": {
            "type": "string",
            "enum": [
              "weapon"
            ]
          },
          "weapon_class": {
            "type": "string",
            "enum": [
              "pistol",
              "smg",
              "rifle",
              "shotgun",
              "sniper",
              "melee"
            ]
          },
          "damage": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 99999.99,
            "multipleOf": 0.01
          },
          "fire_rate": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 9999.99,
            "multipleOf": 0.01
          },
          "effective_range": {
            "type": "number",
            "minimum": 0,
            "maximum": 9999.99,
            "multipleOf": 0.01
          },
          "magazine_size": {
            "type": [
              "integer",
              "null"
