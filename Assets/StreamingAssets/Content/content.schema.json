            "minimum": 1,
            "maximum": 2147483647,
            "multipleOf": 1
          },
          "reload_time_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 999.99,
            "multipleOf": 0.01
          },
          "ammo_item_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "ammo_type": {
            "type": "string",
            "enum": [
              "ammo"
            ]
          },
          "max_durability": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "multipleOf": 1
          },
          "durability_per_use": {
            "type": "number",
            "minimum": 0,
            "maximum": 999.999,
            "multipleOf": 0.001
          },
          "noise_radius": {
            "type": "number",
            "minimum": 0,
            "maximum": 9999.99,
            "multipleOf": 0.01
          },
          "is_suppressed": {
            "type": "boolean"
          },
          "content_version_id": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        }
      }
    },
    "consumables": {
      "type": "array",
      "items": {
        "type": "object",
