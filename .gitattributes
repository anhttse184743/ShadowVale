# Text normalisation
* text=auto -filter
# Unity YAML: never let Git 3-way merge these; use UnityYAMLMerge
*.unity      -text merge=unityyamlmerge diff
*.prefab     -text merge=unityyamlmerge diff
*.asset      -text merge=unityyamlmerge diff
*.mat        -text merge=unityyamlmerge diff
*.anim       -text merge=unityyamlmerge diff
*.controller -text merge=unityyamlmerge diff
*.meta       -text merge=unityyamlmerge diff
*.physicMaterial -text merge=unityyamlmerge diff
*.inputactions text
# Binary assets stored directly in Git (no LFS)
*.png -text -diff -merge -filter
*.jpg -text -diff -merge -filter
*.jpeg -text -diff -merge -filter
*.psd -text -diff -merge -filter
*.tga -text -diff -merge -filter
*.tif -text -diff -merge -filter
*.exr -text -diff -merge -filter
*.hdr -text -diff -merge -filter
*.wav -text -diff -merge -filter
*.mp3 -text -diff -merge -filter
*.ogg -text -diff -merge -filter
*.fbx -text -diff -merge -filter
*.FBX -text -diff -merge -filter
*.obj -text -diff -merge -filter
*.blend -text -diff -merge -filter
*.ttf -text -diff -merge -filter
*.otf -text -diff -merge -filter
*.dll -text -diff -merge -filter
*.mp4 -text -diff -merge -filter
